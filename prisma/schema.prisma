generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER
  MOD
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MemberRole {
  ADMIN
  MEMBER
}

model User {
  id          String    @id @default(cuid())
  phone       String    @unique
  displayName String?
  about       String?
  avatarUrl   String?
  bannedAt    DateTime?
  lastSeenAt  DateTime?
  /// everyone | contacts | nobody
  lastSeenPrivacy String @default("everyone")
  /// everyone | same_as_last_seen | nobody
  onlinePrivacy   String @default("everyone")
  /// everyone | contacts | contacts_except | only_share
  statusPrivacy    String @default("contacts")
  /// User ids for contacts_except / only_share
  statusPrivacyIds Json?
  /// everyone | contacts | nobody
  profilePhotoPrivacy String @default("everyone")
  /// everyone | contacts | nobody
  aboutPrivacy        String @default("everyone")
  /// everyone | contacts | contacts_except
  groupsPrivacy       String @default("everyone")
  silenceUnknownCallers Boolean @default(false)
  /// Wave 39 — everyone | contacts | nobody (who can open your profile via QR / link)
  linksPrivacy String @default("contacts")
  /// Wave 39 — send/receive read receipts (blue ticks)
  readReceipts Boolean @default(true)
  /// Wave 41 — default timer for new DIRECT chats (0 | 86400 | 604800 | 7776000)
  defaultDisappearingSeconds Int @default(0)
  /// Wave 41 — advanced privacy
  protectIpInCalls       Boolean @default(true)
  disableLinkPreviews    Boolean @default(false)
  blockUnknownMessages   Boolean @default(false)
  /// bcrypt hash of 6-digit two-step PIN (Wave 22)
  twoStepPinHash   String?
  twoStepEnabledAt DateTime?
  twoStepEmail     String?
  /// Wave 30 — when recovery email was verified
  emailVerifiedAt  DateTime?
  /// bcrypt hash of chat-lock secret code (Wave 25)
  chatLockPinHash    String?
  chatLockEnabledAt  DateTime?
  chatLockHideFolder Boolean @default(false)
  /// Wave 34 — media auto-download / data prefs (photos | photos_audio | all | none)
  autoDlMobile       String  @default("photos")
  autoDlWifi         String  @default("all")
  autoDlRoaming      String  @default("none")
  lessDataCalls      Boolean @default(false)
  /// auto | high | data_saver
  photoUploadQuality String  @default("auto")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  refreshTokens   RefreshToken[]
  devices         Device[]
  otpChallenges   OtpChallenge[]
  memberships     ConversationMember[]
  reportsFiled    Report[]             @relation("ReportsFiled")
  reportsAgainst  Report[]             @relation("ReportsAgainst")
  blocksCreated   Block[]              @relation("BlocksCreated")
  blocksReceived  Block[]              @relation("BlocksReceived")
  callsInitiated  Call[]               @relation("CallsInitiated")
  callParticipants CallParticipant[]
  callLinksCreated CallLink[]          @relation("CallLinksCreated")
  scheduledCallsOrganized ScheduledCall[] @relation("ScheduledCallsOrganized")
  scheduledCallParticipants ScheduledCallParticipant[]
  statuses        Status[]
  statusViews     StatusView[]
  deviceLinkSessions DeviceLinkSession[]
  chatLists       ChatList[]
}

/** Wave 42 — user-defined chat filter lists (Favourites-style custom). */
model ChatList {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   ChatListMember[]

  @@index([userId, sortOrder])
}

model ChatListMember {
  listId         String
  conversationId String
  list           ChatList     @relation(fields: [listId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([listId, conversationId])
  @@index([conversationId])
}

/** Wave 31 — companion device pairing (code shown on new device, approved on phone). */
model DeviceLinkSession {
  id         String    @id @default(cuid())
  code       String    @unique
  /// pending | approved | cancelled | consumed
  status     String    @default("pending")
  deviceName String?
  platform   String?
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedAt DateTime?
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([status, expiresAt])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksCreated", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  /// Plain code for admin viewer when OTP_DEV_BYPASS=1 only. Null in real SMS mode.
  devCode    String?
  /// login (default) | change_number
  purpose    String    @default("login")
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  deviceId  String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Device {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String?
  name      String?
  platform  String?
  pushToken String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String?
  role         AdminRole @default(MOD)
  totpSecret   String?
  totpEnabledAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AdminAuditLog[]
}

model AdminAuditLog {
  id        String    @id @default(cuid())
  actorId   String
  actor     AdminUser @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  meta      Json?
  createdAt DateTime  @default(now())

  @@index([actorId, createdAt])
}

model Conversation {
  id          String           @id @default(cuid())
  type        ConversationType
  title       String?
  description String?
  avatarUrl   String?
  /// Sorted "userA:userB" for DIRECT uniqueness.
  directKey   String?          @unique
  onlyAdminsCanSend     Boolean @default(false)
  onlyAdminsCanEditInfo Boolean @default(false)
  /// 0 = off; otherwise TTL seconds for new messages (24h / 7d / 90d).
  disappearingSeconds   Int     @default(0)
  disappearingSetBy     String?
  disappearingSetAt     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  members  ConversationMember[]
  messages Message[]
  calls    Call[]
  scheduledCalls ScheduledCall[]
  chatListMembers ChatListMember[]
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  FILE
  VIDEO
  CONTACT
  LOCATION
  POLL
  EVENT
  STICKER
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model Message {
  id                    String        @id @default(cuid())
  conversationId        String
  conversation          Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId              String
  type                  MessageType   @default(TEXT)
  text                  String?
  /// AttachmentDto-shaped JSON (url, key, mime, size, …)
  attachment            Json?
  /// LinkPreviewDto-shaped JSON (url, title, description, …)
  preview               Json?
  clientId              String?
  status                MessageStatus @default(SENT)
  deletedForEveryoneAt  DateTime?
  replyToId             String?
  replyTo               Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies               Message[]     @relation("MessageReplies")
  forwarded             Boolean       @default(false)
  /// Rich payload for CONTACT / LOCATION / POLL / EVENT (and future).
  payload               Json?
  expiresAt             DateTime?
  editedAt              DateTime?
  viewOnce              Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  hides         MessageHide[]
  stars         MessageStar[]
  reactions     MessageReaction[]
  receipts      MessageReceipt[]
  viewOnceOpens MessageViewOnceOpen[]

  @@unique([conversationId, clientId])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@index([expiresAt])
}

/// Per-user "delete for me" (message hidden only for this user).
model MessageHide {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}

model MessageStar {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId, createdAt])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([messageId, userId])
  @@index([messageId])
}

model MessageReceipt {
  id          String    @id @default(cuid())
  messageId   String
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId      String
  deliveredAt DateTime?
  readAt      DateTime?

  @@unique([messageId, userId])
  @@index([messageId])
}

model MessageViewOnceOpen {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  openedAt  DateTime @default(now())

  @@unique([messageId, userId])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MemberRole   @default(MEMBER)
  joinedAt       DateTime     @default(now())
  archived       Boolean      @default(false)
  mutedUntil     DateTime?
  pinnedAt       DateTime?
  /// "Clear chat" for me — hide messages at or before this time.
  clearedAt      DateTime?
  favoritedAt    DateTime?
  /// Client wallpaper key, e.g. "default" | "mint" | "dusk".
  wallpaper      String?
  /// Wave 25 — chat lock (per-member)
  lockedAt       DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([userId, pinnedAt])
  @@index([userId, lockedAt])
}

enum CallMedia {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  REJECTED
  MISSED
}

enum CallParticipantStatus {
  RINGING
  JOINED
  LEFT
  REJECTED
  MISSED
}

model Call {
  id             String     @id @default(cuid())
  kind           String     @default("direct")
  media          CallMedia  @default(AUDIO)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  initiatorId    String
  initiator      User       @relation("CallsInitiated", fields: [initiatorId], references: [id], onDelete: Cascade)
  roomName       String     @unique
  status         CallStatus @default(RINGING)
  endReason      String?
  startedAt      DateTime   @default(now())
  answeredAt     DateTime?
  endedAt        DateTime?
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  participants   CallParticipant[]
  linkSessions   CallLink[]        @relation("CallLinkActiveCall")

  @@index([status, createdAt])
  @@index([initiatorId])
  @@index([conversationId])
}

/** Shareable join link — no prior chat required (Wave 19). */
model CallLink {
  id           String    @id @default(cuid())
  code         String    @unique
  media        CallMedia @default(AUDIO)
  title        String?
  creatorId    String
  creator      User      @relation("CallLinksCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  activeCallId String?
  activeCall   Call?     @relation("CallLinkActiveCall", fields: [activeCallId], references: [id], onDelete: SetNull)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([creatorId])
  @@index([expiresAt])
}

model CallParticipant {
  id        String                @id @default(cuid())
  callId    String
  call      Call                  @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    CallParticipantStatus @default(RINGING)
  joinedAt  DateTime?
  leftAt    DateTime?
  createdAt DateTime              @default(now())

  @@unique([callId, userId])
  @@index([userId])
}

enum ScheduledCallStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

enum ScheduledCallInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model ScheduledCall {
  id              String              @id @default(cuid())
  title           String
  media           CallMedia           @default(AUDIO)
  startsAt        DateTime
  durationMinutes Int                 @default(30)
  reminderMinutes Int                 @default(10)
  organizerId     String
  organizer       User                @relation("ScheduledCallsOrganized", fields: [organizerId], references: [id], onDelete: Cascade)
  conversationId  String?
  conversation    Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  status          ScheduledCallStatus @default(UPCOMING)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  participants    ScheduledCallParticipant[]

  @@index([organizerId, startsAt])
  @@index([status, startsAt])
  @@index([conversationId])
}

model ScheduledCallParticipant {
  id              String                    @id @default(cuid())
  scheduledCallId String
  scheduledCall   ScheduledCall             @relation(fields: [scheduledCallId], references: [id], onDelete: Cascade)
  userId          String
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          ScheduledCallInviteStatus @default(PENDING)
  respondedAt     DateTime?
  createdAt       DateTime                  @default(now())

  @@unique([scheduledCallId, userId])
  @@index([userId])
}

/// Ephemeral status update (24h).
model Status {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// text | image | video
  kind        String   @default("text")
  text        String?
  background  String?
  attachment  Json?
  /// everyone | contacts | contacts_except | only_share (snapshot at create)
  audience    String   @default("contacts")
  audienceIds Json?
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  views       StatusView[]

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model StatusView {
  id        String   @id @default(cuid())
  statusId  String
  status    Status   @relation(fields: [statusId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seenAt    DateTime @default(now())
  reaction  String?
  createdAt DateTime @default(now())

  @@unique([statusId, userId])
  @@index([userId])
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id                   String       @id @default(cuid())
  reporterId           String
  reporter             User         @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUserId         String?
  targetUser           User?        @relation("ReportsAgainst", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetConversationId String?
  reason               String?
  messageIds           Json?
  status               ReportStatus @default(OPEN)
  resolutionNote       String?
  resolvedAt           DateTime?
  resolvedByAdminId    String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([targetUserId])
}

/** Singleton ops settings (Wave 20) — JSON blob matches admin SettingsMap. */
model AppConfig {
  id        String   @id @default("default")
  data      Json
  updatedAt DateTime @updatedAt
}

/** Dial-code allowlist for signup (Wave 20). */
model Country {
  iso       String   @id
  name      String
  dial      String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, sortOrder])
}

/** Wave 21 — broadcast channels */
model Channel {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  avatarUrl   String?
  verified    Boolean  @default(false)
  listed      Boolean  @default(true)
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts     ChannelPost[]
  followers ChannelFollow[]

  @@index([listed, updatedAt])
}

model ChannelFollow {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  muted     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([channelId, userId])
  @@index([userId])
}

model ChannelPost {
  id        String    @id @default(cuid())
  channelId String
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String?
  text      String
  viewCount Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  reactions ChannelPostReaction[]

  @@index([channelId, createdAt])
}

model ChannelPostReaction {
  id        String      @id @default(cuid())
  postId    String
  post      ChannelPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String
  createdAt DateTime    @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

/** Wave 21 — communities shell */
model Community {
  id                       String   @id @default(cuid())
  name                     String
  description              String?
  avatarUrl                String?
  announcementConversationId String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  members CommunityMember[]
  groups  CommunityGroupLink[]
}

model CommunityMember {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  role        String    @default("member")
  createdAt   DateTime  @default(now())

  @@unique([communityId, userId])
  @@index([userId])
}

model CommunityGroupLink {
  id             String    @id @default(cuid())
  communityId    String
  community      Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  conversationId String
  title          String?
  createdAt      DateTime  @default(now())

  @@unique([communityId, conversationId])
  @@index([conversationId])
}
