generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER
  MOD
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MemberRole {
  ADMIN
  MEMBER
}

model User {
  id          String    @id @default(cuid())
  phone       String    @unique
  displayName String?
  about       String?
  avatarUrl   String?
  bannedAt    DateTime?
  lastSeenAt  DateTime?
  /// everyone | contacts | nobody
  lastSeenPrivacy String @default("everyone")
  /// everyone | same_as_last_seen | nobody
  onlinePrivacy   String @default("everyone")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  refreshTokens   RefreshToken[]
  devices         Device[]
  otpChallenges   OtpChallenge[]
  memberships     ConversationMember[]
  reportsFiled    Report[]             @relation("ReportsFiled")
  reportsAgainst  Report[]             @relation("ReportsAgainst")
  blocksCreated   Block[]              @relation("BlocksCreated")
  blocksReceived  Block[]              @relation("BlocksReceived")
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksCreated", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  /// Plain code for admin viewer when OTP_DEV_BYPASS=1 only. Null in real SMS mode.
  devCode    String?
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  deviceId  String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Device {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String?
  name      String?
  platform  String?
  pushToken String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String?
  role         AdminRole @default(MOD)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AdminAuditLog[]
}

model AdminAuditLog {
  id        String    @id @default(cuid())
  actorId   String
  actor     AdminUser @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  meta      Json?
  createdAt DateTime  @default(now())

  @@index([actorId, createdAt])
}

model Conversation {
  id          String           @id @default(cuid())
  type        ConversationType
  title       String?
  description String?
  avatarUrl   String?
  /// Sorted "userA:userB" for DIRECT uniqueness.
  directKey   String?          @unique
  onlyAdminsCanSend     Boolean @default(false)
  onlyAdminsCanEditInfo Boolean @default(false)
  /// 0 = off; otherwise TTL seconds for new messages (24h / 7d / 90d).
  disappearingSeconds   Int     @default(0)
  disappearingSetBy     String?
  disappearingSetAt     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  members  ConversationMember[]
  messages Message[]
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  FILE
  VIDEO
  CONTACT
  LOCATION
  POLL
  EVENT
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model Message {
  id                    String        @id @default(cuid())
  conversationId        String
  conversation          Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId              String
  type                  MessageType   @default(TEXT)
  text                  String?
  /// AttachmentDto-shaped JSON (url, key, mime, size, …)
  attachment            Json?
  /// LinkPreviewDto-shaped JSON (url, title, description, …)
  preview               Json?
  clientId              String?
  status                MessageStatus @default(SENT)
  deletedForEveryoneAt  DateTime?
  replyToId             String?
  replyTo               Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies               Message[]     @relation("MessageReplies")
  forwarded             Boolean       @default(false)
  /// Rich payload for CONTACT / LOCATION / POLL / EVENT (and future).
  payload               Json?
  expiresAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  hides     MessageHide[]
  stars     MessageStar[]
  reactions MessageReaction[]

  @@unique([conversationId, clientId])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@index([expiresAt])
}

/// Per-user "delete for me" (message hidden only for this user).
model MessageHide {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}

model MessageStar {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId, createdAt])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([messageId, userId])
  @@index([messageId])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MemberRole   @default(MEMBER)
  joinedAt       DateTime     @default(now())
  archived       Boolean      @default(false)
  mutedUntil     DateTime?
  pinnedAt       DateTime?
  /// "Clear chat" for me — hide messages at or before this time.
  clearedAt      DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([userId, pinnedAt])
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id                   String       @id @default(cuid())
  reporterId           String
  reporter             User         @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUserId         String?
  targetUser           User?        @relation("ReportsAgainst", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetConversationId String?
  reason               String?
  messageIds           Json?
  status               ReportStatus @default(OPEN)
  resolutionNote       String?
  resolvedAt           DateTime?
  resolvedByAdminId    String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([targetUserId])
}
